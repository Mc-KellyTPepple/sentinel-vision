# Copy to .env for local development. Never commit .env.
MODEL_NAME=yolo11n.pt
MAX_UPLOAD_MB=20
MAX_VIDEO_SECONDS=30
FRAME_STRIDE=3
MAX_ANALYSIS_FRAMES=300
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Load the detector at start-up (recommended for hosted use). Set false to load on the first request.
PRELOAD_MODEL=true
INFERENCE_IMAGE_SIZE=416
# Comma-separated list of exact origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# Optional: allow Vercel preview deployments, e.g. https://sentinel-vision-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# Used only to verify sign-in tokens with Supabase Auth. Use the project URL and the
# publishable (anon) key; never the secret/service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
